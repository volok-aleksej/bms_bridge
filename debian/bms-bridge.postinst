#!/bin/sh
set -e

CONFIG_DIR=/etc/bms_bridge
CONFIG_FILE=$CONFIG_DIR/bms_bridge.conf
TEMPLATE_FILE=/usr/share/bms_bridge/bms_bridge.conf.template

case "$1" in
    configure)
        # First install or upgrade: drop a working config in place only if
        # the operator has not already customised one. Existing files are
        # left strictly alone, even if the template has new fields — that's
        # documentation work, not a runtime concern.
        if [ ! -e "$CONFIG_FILE" ] && [ -e "$TEMPLATE_FILE" ]; then
            mkdir -p "$CONFIG_DIR"
            cp "$TEMPLATE_FILE" "$CONFIG_FILE"
            chmod 0644 "$CONFIG_FILE"
        fi

        # Migrate the history DB schema / flag an old-format config. Runs
        # before the debhelper-generated service (re)start at the end of
        # this script. Must never fail the install — the script is
        # internally fault-tolerant, but guard it anyway.
        MIGRATE=/usr/share/bms_bridge/migrate-db.sh
        if [ -x "$MIGRATE" ]; then
            "$MIGRATE" "$CONFIG_FILE" "$TEMPLATE_FILE" || \
                echo "bms_bridge: migration script failed, continuing" >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
